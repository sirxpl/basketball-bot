# Keep this file private after filling in credentials. Do not commit .env.
# The Discord BOT is paused by default while its token is rate-limited.
ENABLE_DISCORD_BOT=false

# Discord OAuth2 uses a client ID and secret, not a Discord bot token.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:10000/oauth/callback
SESSION_SECRET=

# Optional AFTER the rate limit clears and you deliberately enable the bot.
DISCORD_TOKEN=
MONGODB_URI=
MONGODB_DATABASE=basketball_bot
TEST_GUILD_ID=

PORT=10000

# Optional canonical public origin for Discord link previews and buttons.
# Set to your HTTPS custom domain after migration, with no path or trailing spaces.
PUBLIC_SITE_URL=https://basketball-bot-6jpx.onrender.com
