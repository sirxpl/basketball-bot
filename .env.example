# Copy this file to .env for local development. NEVER commit real credentials.
DISCORD_TOKEN=replace_with_your_discord_bot_token
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=basketball_bot

# Optional: sync commands instantly to your test Discord server (not globally).
TEST_GUILD_ID=
