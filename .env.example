# Copy to .env for local testing. Do NOT commit .env or live credentials.
DISCORD_TOKEN=replace_with_your_discord_bot_token
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=basketball_bot
# Optional test server for faster command syncing
TEST_GUILD_ID=
# Render sets PORT automatically; local web.py defaults to 10000
PORT=10000
